# SSH Account Management Tests

@baseUrl = http://localhost:3005
@apiKey = c75258f0-940b-4972-b316-63c14a4bb7e3

### Health Check
GET {{baseUrl}}/health

### Create SSH Account
POST {{baseUrl}}/api/v1/ssh/
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "username": "testssh",
  "password": "testpassword",
  "exp": "30",
  "ip_quota": "5"
}

### Check SSH Account
POST {{baseUrl}}/api/v1/ssh/check
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "username": "testssh"
}

### Renew SSH Account
POST {{baseUrl}}/api/v1/ssh/renew
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "username": "testssh",
  "exp": "15"
}

### Delete SSH Account
POST {{baseUrl}}/api/v1/ssh/delete
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "username": "testssh"
}

### Create SSH Account (General Endpoint)
POST {{baseUrl}}/api/v1/accounts
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "username": "testssh2",
  "password": "testpassword",
  "exp": "30",
  "ip_quota": "5",
  "account_type": "ssh"
}

### Check SSH Account (General Endpoint)
POST {{baseUrl}}/api/v1/accounts/check
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "username": "testssh2",
  "account_type": "ssh"
}

### Renew SSH Account (General Endpoint)
POST {{baseUrl}}/api/v1/accounts/renew
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "username": "testssh2",
  "exp": "15",
  "account_type": "ssh"
}

### Delete SSH Account (General Endpoint)
POST {{baseUrl}}/api/v1/accounts/delete
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "username": "testssh2",
  "account_type": "ssh"
}