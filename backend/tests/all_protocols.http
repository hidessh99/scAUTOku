# All Protocols Account Management Tests

@baseUrl = http://localhost:3000
@apiKey = your_api_key_here

### Health Check
GET {{baseUrl}}/health

### Create Accounts (General Endpoint)
# VMESS
POST {{baseUrl}}/api/v1/accounts
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "username": "testallvmess",
  "exp": "30",
  "quota": "10GB",
  "ip_quota": "5",
  "account_type": "vmess"
}

###

# SSH
POST {{baseUrl}}/api/v1/accounts
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "username": "testallssh",
  "password": "testpassword",
  "exp": "30",
  "ip_quota": "5",
  "account_type": "ssh"
}

###

# VLESS
POST {{baseUrl}}/api/v1/accounts
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "username": "testallvless",
  "exp": "30",
  "quota": "10GB",
  "ip_quota": "5",
  "account_type": "vless"
}

###

# TROJAN
POST {{baseUrl}}/api/v1/accounts
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "username": "testalltrojan",
  "password": "testpassword",
  "exp": "30",
  "ip_quota": "5",
  "account_type": "trojan"
}

###

# SHADOWSOCKS
POST {{baseUrl}}/api/v1/accounts
Content-Type: application/json
Authorization: Bearer {{apiKey}}

{
  "username": "testallss",
  "password": "testpassword",
  "exp": "30",
  "ip_quota": "5",
  "account_type": "shadowsocks"
}

